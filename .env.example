IMAGE_API_KEY=            # Flux Schnell provider (fal.ai / Replicate)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
META_ACCESS_TOKEN=
META_IG_USER_ID=
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
ALERT_WEBHOOK_URL=        # Discord/Slack webhook for alerts
# Optional, off by default
ELEVENLABS_API_KEY=
# Kill switch (repo variable in CI)
PIPELINE_ENABLED=false
