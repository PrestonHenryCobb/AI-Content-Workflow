# Copy to .env for local runs. In CI these are GitHub Actions secrets.
# Claude runs on your Pro subscription: `claude setup-token`, paste the token here / as a secret.
# Do NOT set ANTHROPIC_API_KEY: the pipeline strips it, and it would mean per-token billing.
CLAUDE_CODE_OAUTH_TOKEN=
IMAGE_API_KEY=            # Flux Schnell provider (fal.ai / Replicate)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
META_ACCESS_TOKEN=
META_IG_USER_ID=
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
ALERT_WEBHOOK_URL=        # Discord/Slack webhook for alerts
# Optional, off by default
ELEVENLABS_API_KEY=
# Kill switch (repo variable in CI)
PIPELINE_ENABLED=false
